#!/bin/sh

umask 077

# shellcheck disable=SC1091
. /lib/functions.sh
# shellcheck source=root/usr/lib/h5000m-pwmfan/controller-lib.sh
. /usr/lib/h5000m-pwmfan/controller-lib.sh

CONFIG=h5000m_pwmfan
SECTION=main
RUNDIR=/var/run/h5000m-pwmfan
TAKEOVER_STATE=$RUNDIR/thermal-takeover
TAKEOVER_TRIED=0
HISTORY_FILE=$RUNDIR/protection-history
TEMP_HISTORY_FILE=$RUNDIR/temperature-history
NEXT_HISTORY_PRUNE=0
STATUS_FILE=$RUNDIR/status
PID_FILE=$RUNDIR/pid
HW_MON_DIR=${H5000M_SYS_CLASS_HWMON:-/sys/class/hwmon}
THERMAL_DIR=${H5000M_SYS_CLASS_THERMAL:-/sys/class/thermal}
MODEM_CACHE_FILE=${H5000M_MODEM_CACHE_FILE:-/tmp/5gmodem/tele.json}
ACTIVE_OWNER=0
FAILSAFE_PWM=255
MAX_PWM=255
MODE=balanced
CURVE=
OWNER=none
SENSOR_STATUS=
CONTROL_TEMP_MC=
CONTROL_SOURCE=
SAFETY_TEMP_MC=
SAFETY_SOURCE=
LAST_PWM=
LAST_TEMP=
LAST_CHANGE=0
LAST_SAMPLE=
LAST_MODE=
PWM_WRITES=0
PI_INTEGRAL=0
PROTECTION_LOCKED=0
PROTECTION_ACTIVE=0
PROTECTION_COUNT=0
HISTORY_READY=0
PROTECTION_PWM=--
MODE_PWM=--

cfg_number() {
	value=$1
	minimum=$2
	maximum=$3
	in_range "$value" "$minimum" "$maximum" || return 1
	value=${value#"${value%%[!0]*}"}
	value=${value:-0}
	printf '%s\n' "$value"
}

find_fan() {
	for hwmon in "$HW_MON_DIR"/hwmon*; do
		[ -r "$hwmon/name" ] || continue
		[ "$(cat "$hwmon/name" 2>/dev/null)" = pwmfan ] || continue
		[ -w "$hwmon/pwm1" ] || continue
		printf '%s\n' "$hwmon/pwm1"
		return 0
	done
	return 1
}

add_sensor() {
	id=$1
	label=$2
	file=$3
	value=
	state=missing
	if [ -r "$file" ]; then
		value=$(cat "$file" 2>/dev/null) || value=
		if valid_temp_mc "$value"; then state=ok; else state=invalid; fi
	fi
	record_sensor "$id" "$label" "$value" "$state"
}

add_modem_sensor() {
	value=
	state=missing
	MODEM_MIN_PWM=0
	if [ -r "$MODEM_CACHE_FILE" ] && command -v jsonfilter >/dev/null 2>&1; then
		mtime=$(stat -c %Y "$MODEM_CACHE_FILE" 2>/dev/null) || mtime=
		now=$(date +%s)
		case "$mtime" in '' | *[!0-9]*) state=invalid ;; *)
			age=$((now - mtime))
			if [ "$age" -lt 0 ] || [ "$age" -gt 90 ]; then
				state=stale
			else
				degrees=$(jsonfilter -i "$MODEM_CACHE_FILE" -e '@.temp' 2>/dev/null) || degrees=
				throttle=$(jsonfilter -i "$MODEM_CACHE_FILE" -e '@.therm' 2>/dev/null) || throttle=
				if valid_temp_c "$degrees"; then
					value=$((degrees * 1000))
					state=ok
					MODEM_MIN_PWM=$(modem_throttle_pwm "$throttle") || MODEM_MIN_PWM=0
				else
					state=invalid
				fi
			fi
			;;
		esac
	elif [ -e "$MODEM_CACHE_FILE" ]; then
		state=unsupported
	fi
	record_sensor modem modem "$value" "$state"
}

collect_sensors() {
	CONTROL_TEMP_MC=
	CONTROL_SOURCE=
	SAFETY_TEMP_MC=
	SAFETY_SOURCE=
	SENSOR_STATUS=
	for zone in "$THERMAL_DIR"/thermal_zone*; do
		[ -r "$zone/temp" ] || continue
		zone_id=${zone##*/}
		zone_type=$(cat "$zone/type" 2>/dev/null) || zone_type=$zone_id
		zone_label=$(printf '%s' "$zone_type" | tr ' |;=' '____')
		add_sensor "tz_${zone_id}" "$zone_label" "$zone/temp"
	done
	for hwmon in "$HW_MON_DIR"/hwmon*; do
		[ -r "$hwmon/name" ] || continue
		hwmon_id=${hwmon##*/}
		hwmon_name=$(cat "$hwmon/name" 2>/dev/null) || hwmon_name=$hwmon_id
		hwmon_label=$(printf '%s' "$hwmon_name" | tr ' |;=' '____')
		for input in "$hwmon"/temp*_input; do
			[ -r "$input" ] || continue
			input_id=${input##*/}
			input_id=${input_id%_input}
			add_sensor "${hwmon_id}_${input_id}" "${hwmon_label}_${input_id}" "$input"
		done
	done
	add_modem_sensor
	[ -n "$CONTROL_TEMP_MC" ]
}

write_status() {
	state=$1
	reason=$2
	requested=$3
	effective=$4
	temperature=${CONTROL_TEMP_MC:---}
	source=${CONTROL_SOURCE:---}
	safety_temperature=${SAFETY_TEMP_MC:---}
	safety_source=${SAFETY_SOURCE:---}
	stamp=$(date +%s)
	if [ "$stamp" -ge "$NEXT_HISTORY_PRUNE" ] && [ -f "$TEMP_HISTORY_FILE" ]; then
		history_tmp="$TEMP_HISTORY_FILE.$$"
		temperature_history_read "$TEMP_HISTORY_FILE" "$stamp" >"$history_tmp" && mv "$history_tmp" "$TEMP_HISTORY_FILE"
	fi
	if [ "$stamp" -ge "$NEXT_HISTORY_PRUNE" ]; then NEXT_HISTORY_PRUNE=$((stamp + 300)); fi
	temperature_history_record "$TEMP_HISTORY_FILE" "$stamp" "$SENSOR_STATUS" || true
	tmp="$STATUS_FILE.$$"
	{
		printf 'state=%s\n' "$state"
		printf 'reason=%s\n' "$reason"
		printf 'mode=%s\n' "$MODE"
		printf 'owner=%s\n' "$OWNER"
		printf 'temperature_mc=%s\n' "$temperature"
		printf 'control_source=%s\n' "$source"
		printf 'safety_temperature_mc=%s\n' "$safety_temperature"
		printf 'safety_source=%s\n' "$safety_source"
		printf 'requested_pwm=%s\n' "$requested"
		printf 'effective_pwm=%s\n' "$effective"
		printf 'protection_pwm=%s\n' "$PROTECTION_PWM"
		printf 'mode_pwm=%s\n' "$MODE_PWM"
		printf 'floor_pwm=%s\n' "$MIN_PWM"
		printf 'floor_limited=%s\n' "${FLOOR_LIMITED:-0}"
		printf 'writes_total=%s\n' "$PWM_WRITES"
		printf 'sensors=%s\n' "$SENSOR_STATUS"
		printf 'updated_at=%s\n' "$stamp"
	} >"$tmp" && mv "$tmp" "$STATUS_FILE"
}

set_pwm() {
	requested=$1
	[ -n "$PWM_FILE" ] && [ -w "$PWM_FILE" ] || return 1
	previous=$(cat "$PWM_FILE" 2>/dev/null) || previous=unknown
	if [ "$previous" != "$requested" ]; then
		logger -t h5000m-pwmfan "pwm $previous -> $requested"
	fi
	printf '%s\n' "$requested" >"$PWM_FILE" 2>/dev/null || return 1
	PWM_WRITES=$((PWM_WRITES + 1))
	effective=$(cat "$PWM_FILE" 2>/dev/null) || return 1
	in_range "$effective" 0 255 || return 1
	ACTIVE_OWNER=1
	OWNER=userspace
	return 0
}

# Re-applying an unchanged duty can glitch the PWM output: the MTK channel
# recalculates its divider on every apply and the fan is briefly audible.
# Write only when the readback differs; the readback is taken every cycle, so an
# external writer is still noticed and corrected on the next poll.
set_pwm_if_changed() {
	requested=$1
	[ -n "$PWM_FILE" ] && [ -w "$PWM_FILE" ] || return 1
	current=$(cat "$PWM_FILE" 2>/dev/null) || current=
	if [ "$current" = "$requested" ]; then
		effective=$current
		ACTIVE_OWNER=1
		OWNER=userspace
		return 0
	fi
	set_pwm "$requested"
}

failsafe() {
	reason=$1
	requested=$FAILSAFE_PWM
	if set_pwm "$requested"; then
		LAST_PWM=$requested
		write_status failsafe "$reason" "$requested" "$effective"
	else
		write_status fault "${reason}_and_failsafe_write_failed" "$requested" "--"
	fi
}

release_fan() {
	[ "$ACTIVE_OWNER" = 1 ] || return 0
	OWNER=none
	if set_pwm "$FAILSAFE_PWM"; then
		OWNER=none
		write_status disabled released "$FAILSAFE_PWM" "$effective"
	else
		OWNER=none
		write_status fault release_write_failed "$FAILSAFE_PWM" "--"
	fi
	ACTIVE_OWNER=0
}

read_effective_pwm() {
	for hwmon in "$HW_MON_DIR"/hwmon*; do
		[ -r "$hwmon/name" ] || continue
		[ "$(cat "$hwmon/name" 2>/dev/null)" = pwmfan ] || continue
		[ -r "$hwmon/pwm1" ] || continue
		value=$(cat "$hwmon/pwm1" 2>/dev/null) || value=
		in_range "$value" 0 255 || value=--
		printf '%s\n' "$value"
		return
	done
	value=
	in_range "$value" 0 255 || value=--
	printf '%s\n' "$value"
}

load_settings() {
	config_load "$CONFIG" || return 1
	config_get ENABLED "$SECTION" enabled 0
	[ "$ENABLED" = 0 ] || [ "$ENABLED" = 1 ] || return 1
	config_get TAKEOVER "$SECTION" kernel_takeover 0
	[ "$TAKEOVER" = 0 ] || [ "$TAKEOVER" = 1 ] || return 1
	config_get TAKEOVER_VERIFIED "$SECTION" takeover_verified 0
	[ "$TAKEOVER_VERIFIED" = 0 ] || [ "$TAKEOVER_VERIFIED" = 1 ] || return 1
	config_get MODE "$SECTION" mode balanced
	case "$MODE" in quiet | balanced | performance | custom | manual | kernel | target | fixed) ;; *) return 1 ;; esac
	config_get SENSOR_SELECTION "$SECTION" sensor_sources auto
	[ -n "$SENSOR_SELECTION" ] || SENSOR_SELECTION=auto
	raw=
	config_get raw "$SECTION" min_pwm 51
	MIN_PWM=$(cfg_number "$raw" 0 255) || return 1
	config_get raw "$SECTION" max_pwm 255
	MAX_PWM=$(cfg_number "$raw" 1 255) || return 1
	[ "$MIN_PWM" -le "$MAX_PWM" ] || return 1
	config_get raw "$SECTION" kick_pwm 255
	KICK_PWM=$(cfg_number "$raw" 0 255) || return 1
	config_get raw "$SECTION" kick_ms 750
	KICK_MS=$(cfg_number "$raw" 0 5000) || return 1
	config_get raw "$SECTION" hysteresis 3
	HYSTERESIS=$(cfg_number "$raw" 0 30) || return 1
	config_get raw "$SECTION" down_delay 10
	DOWN_DELAY=$(cfg_number "$raw" 0 600) || return 1
	config_get raw "$SECTION" poll_interval 2
	POLL_INTERVAL=$(cfg_number "$raw" 1 30) || return 1
	config_get DRIVE "$SECTION" drive curve
	case "$DRIVE" in curve | duty) ;; *) return 1 ;; esac
	config_get raw "$SECTION" protection_temp 90
	SAFETY_TEMP=$(cfg_number "$raw" 80 100) || return 1
	config_get raw "$SECTION" protection_radius 15
	PROTECTION_RADIUS=$(cfg_number "$raw" 15 "$((SAFETY_TEMP + 40))") || return 1
	config_get raw "$SECTION" protection_release 5
	PROTECTION_RELEASE=$(cfg_number "$raw" 2 100) || return 1
	case "$MODE" in
	fixed)
		config_get raw "$SECTION" fixed_duty 0
		FIXED_DUTY=$(cfg_number "$raw" 0 100) || return 1
		;;
	target)
		config_get raw "$SECTION" target_temp 85
		TARGET_TEMP=$(cfg_number "$raw" 80 "$SAFETY_TEMP") || return 1
		config_get raw "$SECTION" response_range 15
		RESPONSE_RANGE=$(cfg_number "$raw" 15 "$TARGET_TEMP") || return 1
		config_get raw "$SECTION" transition_width 5
		TRANSITION_WIDTH=$(cfg_number "$raw" 2 10) || return 1
		config_get raw "$SECTION" target_idle_pwm 0
		TARGET_IDLE=$(cfg_number "$raw" 0 "$MAX_PWM") || return 1
		;;
	quiet | balanced | performance)
		case "$MODE" in
		quiet)
			preset='35:51,45:64,55:96,65:160,75:224,85:255'
			duty=30
			;;
		balanced)
			preset='30:64,42:96,54:144,66:200,76:240,84:255'
			duty=50
			;;
		performance)
			preset='25:128,34:160,43:192,52:224,61:240,70:255'
			duty=80
			;;
		esac
		if [ "$DRIVE" = duty ]; then
			config_get raw "$SECTION" "duty_$MODE" "$duty"
			DUTY=$(cfg_number "$raw" 0 100) || return 1
			[ "$((DUTY % 10))" -eq 0 ] || return 1
		else
			config_get CURVE "$SECTION" "curve_$MODE" "$preset"
			curve_validate "$CURVE" || return 1
		fi
		;;
	manual | custom)
		config_get CURVE "$SECTION" "curve_$MODE" '30:51,40:64,50:96,60:144,70:208,80:255'
		curve_validate "$CURVE" "$MIN_PWM" "$MAX_PWM" 6 100 || return 1
		;;
	esac
}

# Prints "<applied> <raw>": the second field is what the mode asked for before
# the floor and ceiling were applied, so the caller can report a floored request.
requested_pwm() {
	case "$MODE:$DRIVE" in
	fixed:duty) value=$(((FIXED_DUTY * 255 + 50) / 100)) ;;
	quiet:duty | balanced:duty | performance:duty) value=$(((DUTY * 255 + 50) / 100)) ;;
	*) value=$(curve_value "$CURVE" "$CONTROL_TEMP_C") || return 1 ;;
	esac
	if [ "$value" -eq 0 ]; then applied=0; else applied=$(clamp_pwm "$value" "$MIN_PWM" "$MAX_PWM") || return 1; fi
	printf '%s %s\n' "$applied" "$value"
}

restore_history() {
	[ "$HISTORY_READY" = 0 ] || return 0
	history=$(protection_history_load "$HISTORY_FILE" "$now") || return 1
	IFS='|' read -r PROTECTION_LOCKED _ PROTECTION_COUNT _ _ <<EOF_HISTORY
$(printf '%s\n' "$history" | head -n 1)
EOF_HISTORY
	PROTECTION_ACTIVE=$PROTECTION_LOCKED
	HISTORY_READY=1
}

calculate_request() {
	previous=${LAST_PWM:-0}
	if [ "$MODE" = target ]; then
		idle=$TARGET_IDLE
		if [ "$idle" -gt 0 ] && [ "$idle" -lt "$MIN_PWM" ]; then idle=$MIN_PWM; fi
		anchor=$MIN_PWM
		[ "$idle" -le "$anchor" ] || anchor=$idle
		feedforward=$(target_drive_pwm "$CONTROL_TEMP_C" "$TARGET_TEMP" "$RESPONSE_RANGE" "$TRANSITION_WIDTH" "$idle" "$anchor" "$MAX_PWM") || return 1
		MODE_PWM=$feedforward
		result=$(protected_target_step "$feedforward" "$((CONTROL_TEMP_MC - TARGET_TEMP * 1000))" "$PI_INTEGRAL" "$CYCLE_ELAPSED" 1000 100000 10000000 30 "$MIN_PWM" "$MAX_PWM" \
			"$SAFETY_TEMP_C" "$SAFETY_TEMP" "$PROTECTION_RADIUS" "$PROTECTION_RELEASE" "$previous" "$PROTECTION_LOCKED" "$PROTECTION_ACTIVE" "$PROTECTION_COUNT") || return 1
		IFS='|' read -r desired reason locked active boost count PI_INTEGRAL _ <<EOF_TARGET
$result
EOF_TARGET
		# A zero request is an explicit stop, so the floor never applies to it.
		if [ "$desired" -gt 0 ] && [ "$desired" -le "$MIN_PWM" ]; then FLOOR_LIMITED=1; fi
		dispatch="$desired|$reason|$locked|$active|$boost|$count"
	else
		PI_INTEGRAL=0
		if ! read -r MODE_PWM raw_pwm <<EOF_REQUEST; then return 1; fi
$(requested_pwm)
EOF_REQUEST
		if [ "$raw_pwm" -gt 0 ] && [ "$raw_pwm" -lt "$MIN_PWM" ]; then FLOOR_LIMITED=1; fi
		dispatch=$(protection_dispatch_step "$MODE_PWM" "$SAFETY_TEMP_C" "$SAFETY_TEMP" "$PROTECTION_RADIUS" "$PROTECTION_RELEASE" "$MIN_PWM" "$previous" "$PROTECTION_LOCKED" "$PROTECTION_ACTIVE" "$PROTECTION_COUNT") || return 1
		IFS='|' read -r desired reason locked active boost count <<EOF_DISPATCH
$dispatch
EOF_DISPATCH
	fi
	if [ "$HISTORY_READY" = 1 ] && ! protection_history_save_step "$HISTORY_FILE" "$now" "$SAFETY_TEMP_C" "$dispatch" >/dev/null; then
		HISTORY_READY=2
		logger -t h5000m-pwmfan 'Could not update protection history'
	fi
	PROTECTION_LOCKED=$locked PROTECTION_ACTIVE=$active PROTECTION_COUNT=$count
}

kernel_takeover_ready() {
	pwm=$(find_fan) || pwm=
	kernel_takeover_ready_dir "${THERMAL_DIR:-/sys/class/thermal}" "$pwm" "$TAKEOVER" "$TAKEOVER_VERIFIED"
}

# A duty the user sets applies at once; only temperature-driven requests are
# damped, so a curve cannot oscillate on sensor noise.
hold_down_allowed() {
	case "$MODE" in
	target | custom) return 0 ;;
	esac
	[ "$DRIVE" = curve ]
}

apply_cycle() {
	PROTECTION_PWM=-- MODE_PWM=-- FLOOR_LIMITED=0
	if ! load_settings; then
		MODE=invalid
		OWNER=none
		if [ "$ACTIVE_OWNER" = 1 ]; then failsafe invalid_configuration; else write_status fault invalid_configuration -- --; fi
		return
	fi
	OWNER=none
	collect_sensors || true
	if [ "$ENABLED" != 1 ] || [ "$MODE" = kernel ] || ! kernel_takeover_ready; then
		thermal_takeover_restore "${THERMAL_DIR:-/sys/class/thermal}" "$TAKEOVER_STATE" || true
		TAKEOVER_TRIED=0
		was_owner=$ACTIVE_OWNER
		release_fan
		[ "$was_owner" = 1 ] && return
		effective=$(read_effective_pwm)
		if [ "$ENABLED" = 1 ] && [ "$MODE" != kernel ]; then
			write_status disabled takeover_pending -- "$effective"
		else
			write_status disabled not_enabled -- "$effective"
		fi
		return
	fi
	PWM_FILE=$(find_fan) || PWM_FILE=
	if [ -z "$PWM_FILE" ]; then
		write_status fault pwmfan_not_found "$FAILSAFE_PWM" --
		return
	fi
	# The kernel may still stop or override the fan through the thermal zone:
	# pin the low pwm-fan trips once so the governor cannot ask for a zero duty
	# or bypass the configurable over-temperature policy.
	if [ "$TAKEOVER_TRIED" != 1 ]; then
		TAKEOVER_TRIED=1
		pin_dir=${THERMAL_DIR:-/sys/class/thermal}
		case "$(thermal_policy_ensure "$pin_dir" 2>/dev/null)" in
		repaired) logger -t h5000m-pwmfan "restored the step_wise thermal governor" ;;
		esac
		if thermal_takeover_apply "$pin_dir" "$TAKEOVER_STATE"; then
			logger -t h5000m-pwmfan "pinned the low pwm-fan trips for the takeover"
		else
			logger -t h5000m-pwmfan "could not pin the low pwm-fan trips"
		fi
	fi
	if ! valid_temp_mc "$CONTROL_TEMP_MC" || ! valid_temp_mc "$SAFETY_TEMP_MC"; then
		failsafe no_valid_temperature
		return
	fi
	CONTROL_TEMP_C=$((CONTROL_TEMP_MC / 1000))
	SAFETY_TEMP_C=$((SAFETY_TEMP_MC / 1000))
	now=$(date +%s)
	read -r uptime _ </proc/uptime || uptime=0
	CYCLE_ELAPSED=${POLL_INTERVAL:-2}
	sample=${uptime%%.*}
	if [ -n "$LAST_SAMPLE" ]; then
		CYCLE_ELAPSED=$((sample - LAST_SAMPLE))
		[ "$CYCLE_ELAPSED" -ge 1 ] || CYCLE_ELAPSED=1
		[ "$CYCLE_ELAPSED" -le 30 ] || CYCLE_ELAPSED=30
	fi
	LAST_SAMPLE=$sample
	if ! restore_history; then
		HISTORY_READY=2
		logger -t h5000m-pwmfan 'Protection history is unavailable'
	fi
	if [ "$LAST_MODE" != "$MODE" ]; then PI_INTEGRAL=0; fi
	LAST_MODE=$MODE
	if ! calculate_request; then
		failsafe invalid_control
		return
	fi
	case "$reason" in
	invalid_sensor | invalid_control)
		failsafe "$reason"
		return
		;;
	protection_ramp | protection_lock) PROTECTION_PWM=$desired ;;
	*) PROTECTION_PWM=0 ;;
	esac
	if [ "$MODEM_MIN_PWM" -gt "$desired" ]; then
		desired=$MODEM_MIN_PWM
		reason=modem_throttle_floor
	fi
	if [ "$desired" -gt 0 ] && [ "$active" = 0 ] && [ -n "$LAST_PWM" ] && [ "$desired" -lt "$LAST_PWM" ] &&
		[ "$MODE" != manual ] && hold_down_allowed; then
		if [ -n "$LAST_TEMP" ] && [ "$CONTROL_TEMP_C" -gt $((LAST_TEMP - HYSTERESIS)) ]; then
			desired=$LAST_PWM
			reason=hysteresis_hold
		elif [ $((now - LAST_CHANGE)) -lt "$DOWN_DELAY" ]; then
			desired=$LAST_PWM
			reason=down_delay_hold
		fi
	fi
	if [ "$boost" = 1 ] && { [ "$active" = 1 ] || { [ "$desired" -gt 0 ] && [ "$KICK_PWM" -gt "$desired" ] && [ "$KICK_MS" -gt 0 ]; }; }; then
		kick=$(clamp_pwm "$KICK_PWM" "$MIN_PWM" "$MAX_PWM") || kick=$MAX_PWM
		if [ "$active" = 1 ]; then kick=255; fi
		if ! set_pwm "$kick"; then
			failsafe startup_kick_write_failed
			return
		fi
		if [ "$active" = 1 ]; then sleep 1; elif command -v usleep >/dev/null 2>&1; then usleep "$((KICK_MS * 1000))"; else sleep 1; fi
	fi
	if [ "$desired" != "$LAST_PWM" ]; then LAST_CHANGE=$now; fi
	if set_pwm_if_changed "$desired"; then
		LAST_PWM=$desired
		LAST_TEMP=$CONTROL_TEMP_C
		if [ "$effective" -ne "$desired" ]; then
			reason=pwm_mismatch
			OWNER=unknown
		elif [ "$active" = 1 ]; then OWNER=protection; fi
		write_status running "$reason" "$desired" "$effective"
	else
		failsafe pwm_write_failed
	fi
}

cleanup() {
	trap - EXIT INT TERM HUP
	thermal_takeover_restore "${THERMAL_DIR:-/sys/class/thermal}" "$TAKEOVER_STATE" || true
	if [ "$ACTIVE_OWNER" = 1 ]; then
		PWM_FILE=$(find_fan) || PWM_FILE=
		if [ -n "$PWM_FILE" ] && set_pwm "$FAILSAFE_PWM"; then
			OWNER=none
			write_status stopped service_exit "$FAILSAFE_PWM" "$effective"
		else
			OWNER=none
			write_status fault service_exit_write_failed "$FAILSAFE_PWM" --
		fi
		ACTIVE_OWNER=0
	fi
	[ ! -f "$PID_FILE" ] || [ "$(cat "$PID_FILE" 2>/dev/null)" != "$$" ] || rm -f "$PID_FILE"
}

daemon() {
	mkdir -p "$RUNDIR"
	printf '%s\n' "$$" >"$PID_FILE"
	trap ':' HUP
	trap 'exit 0' INT TERM
	trap cleanup EXIT
	while :; do
		cycle_start=$(date +%s)
		apply_cycle
		cycle_elapsed=$(($(date +%s) - cycle_start))
		if [ "$cycle_elapsed" -gt 5 ]; then
			logger -t h5000m-pwmfan "slow cycle ${cycle_elapsed}s"
			printf '%s %s\n' "$(date +%T)" "$cycle_elapsed" >>"$RUNDIR/slow-cycles"
		fi
		sleep "${POLL_INTERVAL:-2}"
	done
}

case "${1:-status}" in
daemon) daemon ;;
status) [ ! -r "$STATUS_FILE" ] || cat "$STATUS_FILE" ;;
reload)
	if [ -r "$PID_FILE" ]; then kill -HUP "$(cat "$PID_FILE")" 2>/dev/null || exit 1; fi
	;;
*)
	printf 'Usage: %s {daemon|status|reload}\n' "$0" >&2
	exit 2
	;;
esac
