#!/bin/sh /etc/rc.common

# shellcheck disable=SC2034
START=95
# shellcheck disable=SC2034
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/h5000m-pwmfan daemon
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 10
	procd_close_instance
}

reload_service() {
	procd_send_signal h5000m-pwmfan '' HUP
}

service_triggers() {
	procd_add_reload_trigger h5000m_pwmfan
}
