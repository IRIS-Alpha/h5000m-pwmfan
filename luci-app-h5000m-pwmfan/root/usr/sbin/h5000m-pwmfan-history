#!/bin/sh
# Print the temperature history the controller has recorded, trimmed to the
# window the dashboard draws.
#
# The LuCI file RPC on this firmware rejects `exec` calls that carry arguments,
# so this helper takes none: it reads the window from the saved configuration
# instead of from the caller.
runtime_dir=/var/run/h5000m-pwmfan
file=$runtime_dir/temperature-history

range=$(uci -q get h5000m_pwmfan.main.history_range 2>/dev/null)
case "$range" in
	'' | *[!0-9]*) range=5 ;;
esac
[ "$range" -lt 5 ] && range=5
[ "$range" -gt 360 ] && range=360

now=$(date +%s)
cutoff=$((now - range * 60))

# One pass over the file: the controller already keeps it trimmed to twice the
# window, so a second awk in the pipeline would only cost another fork.
awk -F '|' -v cutoff="$cutoff" 'NF == 5 && $1 + 0 >= cutoff { print }' "$file" 2>/dev/null
